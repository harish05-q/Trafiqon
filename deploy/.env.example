# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.
# Used with: docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file deploy/.env ...

# Public address. A domain gets automatic HTTPS (ports 80 and 443 must reach the server).
SITE_ADDRESS=trafiqon-example.duckdns.org
PUBLIC_WEB_URL=https://trafiqon-example.duckdns.org

# Database password: letters and digits only (it is part of a URL). Generate: openssl rand -hex 24
# It is applied when the database volume is FIRST created; changing it later does not change the DB.
POSTGRES_PASSWORD=change-me

# Login prompt for the whole site (Caddy basic auth).
# Hash: docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the hash contains '$', which Compose would otherwise expand.
BASIC_AUTH_USER=trafiqon
BASIC_AUTH_HASH='$2a$14$replace.with.the.output.of.caddy.hash-password'

# Host ports (leave as is on a server)
# HTTP_PORT=80
# HTTPS_PORT=443
