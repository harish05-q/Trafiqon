# Backend (FastAPI + worker)
# Database (docker compose `db` service). Leave unset to run only the DB-free routes.
TRAFIQON_DATABASE_URL=postgresql+psycopg://trafiqon:trafiqon@localhost:5432/trafiqon
# Integration tests (database is dropped/recreated by the test session)
TRAFIQON_TEST_DATABASE_URL=postgresql+psycopg://trafiqon:trafiqon@localhost:5432/trafiqon_test
# Comma-separated allowed browser origins
TRAFIQON_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Worker
TRAFIQON_WORKER_POLL_INTERVAL_S=0.5
TRAFIQON_HEARTBEAT_INTERVAL_S=1.0
TRAFIQON_STALE_AFTER_S=30
TRAFIQON_MAX_ATTEMPTS=2
TRAFIQON_PROGRESS_EVENT_MIN_INTERVAL_S=0.5
TRAFIQON_EVENT_RETENTION_DAYS=30
# Simulation sessions (in API memory; see docs/simulation.md)
TRAFIQON_SIMULATION_IDLE_TTL_S=3600
# TRAFIQON_LIMIT_MAX_SIMULATIONS=20

# Docker Compose (docker-compose.yml): host ports and browser-facing URLs
# DB_PORT=5432
# API_PORT=8000
# WEB_PORT=3000
# PUBLIC_API_URL=http://localhost:8000
# PUBLIC_WEB_URL=http://localhost:3000

# Request limits (TRAFIQON_LIMIT_<NAME>; see docs/api_contracts.md), e.g.
# TRAFIQON_LIMIT_MAX_QUEUED_RUNS=200
# TRAFIQON_LIMIT_MAX_TIME_LIMIT_S=120

# Frontend (Next.js): API base URL, inlined at build time
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
