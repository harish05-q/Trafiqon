{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["--directory", "backend", "run", "uvicorn", "trafiqon.api.app:app", "--port", "8000"],
      "env": {
        "TRAFIQON_DATABASE_URL": "postgresql+psycopg://trafiqon:trafiqon@localhost:5432/trafiqon"
      },
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    }
  ]
}
